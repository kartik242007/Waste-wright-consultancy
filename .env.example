# Formspree endpoint IDs — the part after https://formspree.io/f/
# Create one form per site form in the Formspree dashboard (account tied to
# wastewrightconsultancy@gmail.com), then set both in Vercel under
# Settings → Environment Variables for Production, Preview and Development.
#
# These are NEXT_PUBLIC_* because the POST happens in the browser: the IDs
# ship in the client bundle by design. They are submission endpoints, not
# credentials — anyone can post to them, so keep Formspree's own spam
# protection on. Nothing secret belongs in this file or in these vars.
#
# Copy to .env.local for local development (.env* is gitignored).

NEXT_PUBLIC_FORMSPREE_BRIEFING_ID=
NEXT_PUBLIC_FORMSPREE_CONTACT_ID=
